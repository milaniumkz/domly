NODE_ENV=production
STRICT_ENV=true
PORT=8080
PUBLIC_API_URL=https://api.domly.kz

POSTGRES_DB=domly
POSTGRES_USER=domly
POSTGRES_PASSWORD=change_me_postgres_password
DATABASE_URL=postgres://domly:change_me_postgres_password@postgres:5432/domly
REDIS_URL=redis://redis:6379

JWT_ACCESS_SECRET=change_me_access_secret_64_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_64_chars
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

ADMIN_BOOTSTRAP_PHONE=+77781110170
ADMIN_BOOTSTRAP_NAME=DOMLY Superadmin
ADMIN_BOOTSTRAP_PASSWORD=change_me_min_8_chars
ADMIN_BOOTSTRAP_RESET_PASSWORD=false

WAPI_TOKEN=change_me_wapi_token
WAPI_PROFILE_ID=change_me_wapi_profile_id
WAPI_BASE_URL=https://wappi.pro/api
# Display customer/Pro verification codes until explicitly disabled.
OTP_SHOW_CODE=false

KASPI_MERCHANT_ID=
KASPI_API_KEY=
KASPI_BASE_URL=
MOON_AI_WEBHOOK_TOKEN=change_me_moon_ai_webhook_token

BCC_MERCHANT_ID=
BCC_TERMINAL_ID=
BCC_PRIVATE_KEY=
BCC_PUBLIC_KEY=
BCC_NOTIFY_URL=https://api.domly.kz:443/api/v1/payments/bcc/webhook
BCC_RETURN_URL=https://domly.kz/customer/#/client/payment-history

MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ROOT_USER=domly_minio
MINIO_ROOT_PASSWORD=change_me_minio_root_password
MINIO_ACCESS_KEY=domly_minio
MINIO_SECRET_KEY=change_me_minio_secret
MINIO_BUCKET=domly
MINIO_PUBLIC_URL=https://files.domly.kz

FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
# Можно вместо трёх полей выше передать service account одним способом:
FCM_SERVICE_ACCOUNT_JSON=
FCM_SERVICE_ACCOUNT_BASE64=
FCM_SERVICE_ACCOUNT_FILE=

OSM_NOMINATIM_URL=https://nominatim.openstreetmap.org/search
YANDEX_GEOCODER_API_KEY=
YANDEX_GEOSUGGEST_API_KEY=

REQUIRE_EXTERNAL_INTEGRATIONS=false
REQUIRE_WAPI=true
REQUIRE_FCM=true
REQUIRE_PAYMENTS=true
REQUIRE_ADDRESS_FALLBACK=false

BACKUP_S3_ENDPOINT=http://minio:9000
BACKUP_DIR=/backups
BACKUP_MANIFEST=/backups/manifest.jsonl
BACKUP_INTERVAL_SECONDS=86400
BACKUP_KEEP_DAYS=14
MINIO_BACKUP_ENABLED=true

# App Links: public signing certificate fingerprints, comma separated.
APPLE_TEAM_ID=Z3NZN92Y7P
ANDROID_CUSTOMER_CERT_SHA256=
ANDROID_PRO_CERT_SHA256=

# Temporary login code display on delivery failure; disabled when empty or expired.
OTP_FAILURE_FALLBACK_UNTIL=
